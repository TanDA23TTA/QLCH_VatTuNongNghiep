@model VatTuNongNghiep.Models.ViewModels.DangNhapVM
@using Microsoft.Extensions.Hosting
@using VatTuNongNghiep.Helpers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment MoiTruong
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-4 text-center">Đăng nhập</h1>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <!-- Lỗi chung (sai tài khoản, bị khóa...) -->
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="TenDangNhap" class="form-label"></label>
                        <input asp-for="TenDangNhap" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MatKhau" class="form-label"></label>
                        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="MatKhau" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="GhiNho" class="form-check-input" />
                        <label asp-for="GhiNho" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-success w-100">Đăng nhập</button>
                </form>

                <p class="text-center mt-3 mb-0 small">
                    Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a>
                </p>
            </div>
        </div>

        @* Gợi ý tài khoản dùng thử – CHỈ hiện khi chạy ở môi trường Development (F5 / dotnet run) *@
        @if (MoiTruong.IsDevelopment())
        {
            <div class="alert alert-warning mt-3 small" role="note">
                <div class="fw-semibold mb-2">🔑 Tài khoản dùng thử</div>
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <span class="badge text-bg-success">Quản trị</span>
                        <code>@KhoiTaoDuLieu.TenDangNhapAdmin</code> / <code>@KhoiTaoDuLieu.MatKhauAdmin</code>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-success nut-dien-tk"
                            data-ten="@KhoiTaoDuLieu.TenDangNhapAdmin" data-mk="@KhoiTaoDuLieu.MatKhauAdmin">
                        Điền sẵn
                    </button>
                </div>
                <div class="mt-2 text-muted">
                    <span class="badge text-bg-secondary">Khách hàng</span>
                    bấm <a asp-action="Register">Đăng ký</a> để tạo tài khoản mới.
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Bấm "Điền sẵn" → tự điền tên đăng nhập và mật khẩu vào form
        document.querySelectorAll('.nut-dien-tk').forEach(function (nut) {
            nut.addEventListener('click', function () {
                document.getElementById('TenDangNhap').value = nut.dataset.ten;
                document.getElementById('MatKhau').value = nut.dataset.mk;
            });
        });
    </script>
}
