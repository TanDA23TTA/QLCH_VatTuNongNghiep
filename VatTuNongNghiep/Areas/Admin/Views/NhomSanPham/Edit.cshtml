@model NhomSanPhamVM
@{
    ViewData["Title"] = "Sửa nhóm sản phẩm";
}

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Sửa nhóm sản phẩm</div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.Manhom" method="post">
                    <partial name="_Form" model="Model" />
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
