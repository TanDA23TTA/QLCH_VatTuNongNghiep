@{
    ViewData["Title"] = "Tổng quan";
}

<h1 class="h4 mb-4">Chào mừng đến trang quản trị</h1>

<!-- Thẻ thống kê nhanh số lượng danh mục -->
<div class="row g-3">
    <div class="col-6 col-lg-3">
        <a class="the-thongke" asp-controller="NhomSanPham" asp-action="Index">
            <div class="so">@ViewBag.SoNhom</div>
            <div class="nhan">Nhóm sản phẩm</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="the-thongke" asp-controller="ThuongHieu" asp-action="Index">
            <div class="so">@ViewBag.SoThuongHieu</div>
            <div class="nhan">Thương hiệu</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="the-thongke" asp-controller="ThanhPhan" asp-action="Index">
            <div class="so">@ViewBag.SoThanhPhan</div>
            <div class="nhan">Thành phần</div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="the-thongke" asp-controller="CongDung" asp-action="Index">
            <div class="so">@ViewBag.SoCongDung</div>
            <div class="nhan">Công dụng</div>
        </a>
    </div>
</div>
