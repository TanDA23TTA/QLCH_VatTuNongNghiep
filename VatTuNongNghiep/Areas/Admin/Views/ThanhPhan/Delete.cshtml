@model ThanhPhanVM
@{
    ViewData["Title"] = "Xóa thành phần";
    bool dangCoSanPham = Model.SoSanPham > 0;
}

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-white fw-semibold text-danger">Xóa thành phần</div>
            <div class="card-body">
                @if (dangCoSanPham)
                {
                    <div class="alert alert-warning">
                        Thành phần này đang có trong <strong>@Model.SoSanPham sản phẩm</strong> nên <strong>không thể xóa</strong>.
                        Hãy bỏ thành phần này khỏi các sản phẩm đó trước.
                    </div>
                }
                else
                {
                    <p>Bạn có chắc muốn xóa thành phần này? Thao tác <strong>không thể hoàn tác</strong>.</p>
                }

                <dl class="row mb-4">
                    <dt class="col-sm-4">Mã thành phần</dt>
                    <dd class="col-sm-8"><code>@Model.Mathanhphan</code></dd>
                    <dt class="col-sm-4">Tên thành phần</dt>
                    <dd class="col-sm-8">@Model.TenThanhPhan</dd>
                    <dt class="col-sm-4">Loại</dt>
                    <dd class="col-sm-8">@Model.LoaiThanhPhan</dd>
                    <dt class="col-sm-4">Đơn vị hàm lượng</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.DonViHamLuong) ? "—" : Model.DonViHamLuong)</dd>
                    <dt class="col-sm-4">Số sản phẩm chứa</dt>
                    <dd class="col-sm-8">@Model.SoSanPham</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.Mathanhphan" method="post">
                    <button type="submit" class="btn btn-danger" disabled="@dangCoSanPham">Xác nhận xóa</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>
