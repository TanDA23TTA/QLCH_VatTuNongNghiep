@model ThuongHieuVM
@* Các ô nhập dùng chung cho trang Thêm và Sửa *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="mb-3">
    <label asp-for="Mathuonghieu" class="form-label"></label>
    <input asp-for="Mathuonghieu" class="form-control-plaintext fw-bold" readonly />
    <div class="form-text">Mã do hệ thống tự sinh, không sửa được.</div>
</div>

<div class="mb-3">
    <label asp-for="TenThuongHieu" class="form-label"></label> <span class="text-danger">*</span>
    <input asp-for="TenThuongHieu" class="form-control" maxlength="50" autofocus />
    <span asp-validation-for="TenThuongHieu" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="QuocGia" class="form-label"></label>
    <input asp-for="QuocGia" class="form-control" maxlength="50" />
    <span asp-validation-for="QuocGia" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="DiaChi" class="form-label"></label>
    <input asp-for="DiaChi" class="form-control" maxlength="150" />
    <span asp-validation-for="DiaChi" class="text-danger small"></span>
</div>
