@model List<ThuongHieuVM>
@{
    ViewData["Title"] = "Thương hiệu";
    var phanTrang = (PhanTrangVM)ViewBag.PhanTrang;
    int stt = phanTrang.ViTriBatDau;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0">Danh sách thương hiệu</h1>
    <a asp-action="Create" class="btn btn-success">+ Thêm thương hiệu</a>
</div>

<!-- Ô tìm kiếm -->
<form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
    <div class="col-12 col-sm">
        <input type="search" name="tuKhoa" value="@phanTrang.TuKhoa" class="form-control"
               placeholder="Nhập tên, quốc gia hoặc mã thương hiệu (gõ không dấu cũng được)…" aria-label="Từ khóa tìm kiếm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Tìm</button>
        @if (!string.IsNullOrEmpty(phanTrang.TuKhoa))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        }
    </div>
</form>

@if (!string.IsNullOrEmpty(phanTrang.TuKhoa))
{
    <p class="text-muted small">Tìm thấy <strong>@phanTrang.TongSo</strong> thương hiệu với từ khóa “@phanTrang.TuKhoa”.</p>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-center" style="width:60px">STT</th>
                    <th style="width:100px">Mã</th>
                    <th>Tên thương hiệu</th>
                    <th>Quốc gia</th>
                    <th class="d-none d-md-table-cell">Địa chỉ</th>
                    <th class="text-center" style="width:90px">Số SP</th>
                    <th class="text-end" style="width:140px">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            @(string.IsNullOrEmpty(phanTrang.TuKhoa) ? "Chưa có thương hiệu nào." : "Không tìm thấy thương hiệu phù hợp.")
                        </td>
                    </tr>
                }
                @foreach (var th in Model)
                {
                    <tr>
                        <td class="text-center">@(++stt)</td>
                        <td><code>@th.Mathuonghieu</code></td>
                        <td class="fw-semibold">@th.TenThuongHieu</td>
                        <td>@th.QuocGia</td>
                        <td class="d-none d-md-table-cell small text-muted">@th.DiaChi</td>
                        <td class="text-center">@th.SoSanPham</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@th.Mathuonghieu" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@th.Mathuonghieu" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="small text-muted">Tổng: @phanTrang.TongSo thương hiệu</span>
        <partial name="_PhanTrang" model="phanTrang" />
    </div>
</div>
