@model ThuongHieuVM
@{
    ViewData["Title"] = "Xóa thương hiệu";
    bool dangCoSanPham = Model.SoSanPham > 0;
}

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-white fw-semibold text-danger">Xóa thương hiệu</div>
            <div class="card-body">
                @if (dangCoSanPham)
                {
                    <div class="alert alert-warning">
                        Thương hiệu này đang có <strong>@Model.SoSanPham sản phẩm</strong> nên <strong>không thể xóa</strong>.
                        Hãy chuyển các sản phẩm sang thương hiệu khác hoặc xóa chúng trước.
                    </div>
                }
                else
                {
                    <p>Bạn có chắc muốn xóa thương hiệu này? Thao tác <strong>không thể hoàn tác</strong>.</p>
                }

                <dl class="row mb-4">
                    <dt class="col-sm-4">Mã thương hiệu</dt>
                    <dd class="col-sm-8"><code>@Model.Mathuonghieu</code></dd>
                    <dt class="col-sm-4">Tên thương hiệu</dt>
                    <dd class="col-sm-8">@Model.TenThuongHieu</dd>
                    <dt class="col-sm-4">Quốc gia</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.QuocGia) ? "—" : Model.QuocGia)</dd>
                    <dt class="col-sm-4">Địa chỉ</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.DiaChi) ? "—" : Model.DiaChi)</dd>
                    <dt class="col-sm-4">Số sản phẩm</dt>
                    <dd class="col-sm-8">@Model.SoSanPham</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.Mathuonghieu" method="post">
                    <button type="submit" class="btn btn-danger" disabled="@dangCoSanPham">Xác nhận xóa</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>
