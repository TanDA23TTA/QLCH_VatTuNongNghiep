@model CongDungVM
@{
    ViewData["Title"] = "Xóa công dụng";
    bool dangCoSanPham = Model.SoSanPham > 0;
}

<div class="row">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-white fw-semibold text-danger">Xóa công dụng</div>
            <div class="card-body">
                @if (dangCoSanPham)
                {
                    <div class="alert alert-warning">
                        Công dụng này đang gắn với <strong>@Model.SoSanPham sản phẩm</strong> nên <strong>không thể xóa</strong>.
                        Hãy bỏ công dụng này khỏi các sản phẩm đó trước.
                    </div>
                }
                else
                {
                    <p>Bạn có chắc muốn xóa công dụng này? Thao tác <strong>không thể hoàn tác</strong>.</p>
                }

                <dl class="row mb-4">
                    <dt class="col-sm-4">Mã công dụng</dt>
                    <dd class="col-sm-8"><code>@Model.Macongdung</code></dd>
                    <dt class="col-sm-4">Tên công dụng</dt>
                    <dd class="col-sm-8">@Model.TenCongDung</dd>
                    <dt class="col-sm-4">Mô tả</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.MoTa) ? "—" : Model.MoTa)</dd>
                    <dt class="col-sm-4">Số sản phẩm</dt>
                    <dd class="col-sm-8">@Model.SoSanPham</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.Macongdung" method="post">
                    <button type="submit" class="btn btn-danger" disabled="@dangCoSanPham">Xác nhận xóa</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                </form>
            </div>
        </div>
    </div>
</div>
