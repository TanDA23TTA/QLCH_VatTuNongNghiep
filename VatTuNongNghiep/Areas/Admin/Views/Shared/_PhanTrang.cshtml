@model PhanTrangVM
@* Thanh phân trang dùng chung; giữ lại từ khóa và bộ lọc khi chuyển trang *@
@if (Model.TongTrang > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination pagination-sm justify-content-end mb-0">
            <li class="page-item @(Model.Trang == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="Model.ThamSoUrl(Model.Trang - 1)">«</a>
            </li>
            @for (int i = 1; i <= Model.TongTrang; i++)
            {
                <li class="page-item @(i == Model.Trang ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="Model.ThamSoUrl(i)">@i</a>
                </li>
            }
            <li class="page-item @(Model.Trang == Model.TongTrang ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="Model.ThamSoUrl(Model.Trang + 1)">»</a>
            </li>
        </ul>
    </nav>
}
